# Токен бота от @BotFather
BOT_TOKEN=

# Строка подключения к Postgres (Render External Database URL или любая другая)
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=

# API_ID и API_HASH userbot-аккаунта с my.telegram.org (нужны для Telethon —
# используются для управления форумными ветками и /sync)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Публичный HTTPS-адрес мини-аппа, если используется (можно оставить пустым)
MINIAPP_BASE_URL=
